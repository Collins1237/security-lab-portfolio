#!/bin/bash
# den-lab-common — shared helpers sourced by every den-lab-* script.
#   source "$HOME/.local/bin/den-lab-common"
# Provides: theme colors (A/F/D/G/Rr/R), pause/head UI, and a writeup engine so
# EVERY lab auto-produces a professional, portfolio-ready markdown report under
# ~/security-labs/writeups/<id>.md (completion = a writeup exists).

WU_DIR="$HOME/security-labs/writeups"; mkdir -p "$WU_DIR"
AUTHOR="Allan Collins"
THEME="$HOME/.local/state/omarchy/current/theme/colors.toml"

_rgb() { local h=${1#\#}; printf '%d;%d;%d' 0x${h:0:2} 0x${h:2:2} 0x${h:4:2}; }
_c() { sed -n "s/^$1 *= *\"\(#[0-9A-Fa-f]\{6\}\)\".*/\1/p" "$THEME" 2>/dev/null; }
_acc=$(_c accent); _acc=${_acc:-#FFB000}; _fg=$(_c foreground); _fg=${_fg:-#DDDDDD}; _dim=$(_c dark_foreground); _dim=${_dim:-#777777}
A=$'\033[1;38;2;'"$(_rgb "$_acc")m"; F=$'\033[0;38;2;'"$(_rgb "$_fg")m"; D=$'\033[0;38;2;'"$(_rgb "$_dim")m"
G=$'\033[0;32m'; Rr=$'\033[0;31m'; Y=$'\033[0;33m'; R=$'\033[0m'

pause() { echo; printf '%s' "${D}  press any key to continue …${R}"; read -rsn1; echo; echo; }
head() { clear; echo; echo "  ${A}▌ ${LAB_TITLE:-LAB}${R}   ${D}${LAB_PHASE:-}${R}"; [[ -n $1 ]] && echo "  ${D}$1${R}"; echo "  ${D}────────────────────────────────────────────────────${R}"; echo; }
say()  { echo "  ${F}$1${R}"; }
note() { echo "  ${A}•${R} ${F}$1${R}"; }
good() { echo "  ${G}✓ $1${R}"; }
warn() { echo "  ${Y}⚠ $1${R}"; }

# ── writeup engine ────────────────────────────────────────────
# wu_begin <id> "<Title>" "<Phase>"
wu_begin() {
  WU_ID=$1; LAB_TITLE=$2; LAB_PHASE=$3; WU="$WU_DIR/$WU_ID.md"
  LAB_TITLE=$2
  {
    echo "# $2"
    echo
    echo "**Kill-chain phase:** $3  "
    echo "**Date:** $(date '+%Y-%m-%d')  "
    echo "**Analyst:** $AUTHOR  "
    echo "**Environment:** personal home lab (systems I own / am authorized to test)"
    echo
    echo "> ⚖️ **Scope & authorization.** Every action below was performed only against"
    echo "> hosts I own or have explicit permission to test. Unauthorized testing of"
    echo "> third-party systems is illegal (CFAA) — authorization is what separates a"
    echo "> penetration test from a crime."
    echo
  } > "$WU"
}
wu_h()   { echo >> "$WU"; echo "## $1" >> "$WU"; echo >> "$WU"; }     # section heading
wu_p()   { echo "$1" >> "$WU"; echo >> "$WU"; }                        # paragraph
wu_li()  { echo "- $1" >> "$WU"; }                                     # list item
# wu_cmd "<why we run it>" "<shell command string>"  — runs it, shows it live, logs cmd+output
wu_cmd() {
  local why=$1 cmd=$2 out
  echo "  ${D}\$ ${cmd}${R}"
  out=$(bash -c "$cmd" 2>&1)
  [[ -n $out ]] && echo "$out" | sed 's/^/    /'
  { echo "_${why}_"; echo; echo '```console'; echo "\$ ${cmd}"; echo "$out"; echo '```'; echo; } >> "$WU"
  LAST_OUT=$out
}
wu_end() {   # finalize + rebuild portfolio index
  { echo; echo "---"; echo "_Generated by the Den pentester training track._"; } >> "$WU"
  "$HOME/.local/bin/den-writeups" --reindex >/dev/null 2>&1
  echo; good "Writeup saved → $WU"
  echo "  ${D}  view all writeups:  den-writeups   (or Super+Alt+C → Writeups)${R}"
}
